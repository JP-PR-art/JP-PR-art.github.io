---
import { getCollection } from 'astro:content';

const entries = await getCollection('library');
const books = entries
  .map((e) => ({
    id: e.id,
    title: e.data.title,
    author: e.data.author,
    status: e.data.status === 'to-read' ? 'toread' : e.data.status,
    cover: e.data.cover ?? null,
    started: e.data.started ? e.data.started.toISOString().slice(0, 10) : null,
    finished: e.data.finished ? e.data.finished.toISOString().slice(0, 10) : null,
    note: (e.body ?? '').trim(),
  }))
  .sort((a, b) => (b.started ?? '').localeCompare(a.started ?? ''));
---
<div class="scene-wrap" id="sceneWrap">
    <span class="scene-hint">click the library to explore it</span>
    <div class="scene-viewport" id="viewport">
      <div class="layer" id="layerBack">
        <div class="glow"></div>
        <div class="ground"></div>
        <div class="tower-shadow"></div>
      </div>

      <div class="atrium">
        <div class="tower" id="tower">
          <div class="face face-left" data-status="read" role="button" tabindex="0" aria-label="Read shelf">
            <div class="face-label"><span class="w">READ</span><span class="c" data-count="read"></span></div>
          </div>
          <div class="face face-right" data-status="toread" role="button" tabindex="0" aria-label="To-read shelf">
            <div class="face-label"><span class="w">TO READ</span><span class="c" data-count="toread"></span></div>
          </div>
          <div class="face face-front" data-status="reading" role="button" tabindex="0" aria-label="Reading now shelf">
            <div class="tower-sign"><span class="kr">별마당 도서관</span><span class="en">JP · LIBRARY</span></div>
            <div class="face-label" style="top:47%"><span class="w">READING NOW</span><span class="c" data-count="reading"></span></div>
          </div>
        </div>
      </div>

      <div class="closeup" id="closeup">
        <button class="closeup-back" id="closeupBack">← back to the tower</button>
        <div class="closeup-panel">
          <div class="cw" id="closeupWord"></div>
          <div class="closeup-shelf" id="closeupShelf"></div>
        </div>
      </div>

      <div class="detail-overlay" id="overlay">
        <div class="detail-card">
          <button class="detail-close" id="dClose">✕ close</button>
          <div class="detail-cover" id="dCover"></div>
          <div class="detail-info">
            <h3 id="dTitle"></h3>
            <p class="author" id="dAuthor"></p>
            <span class="detail-status" id="dStatus"></span>
            <p class="dates" id="dDates"></p>
            <p class="blurb" id="dBlurb"></p>
          </div>
        </div>
      </div>
    </div>
    <div class="scene-legend" id="legend">
      <button class="legend-chip" data-status="read"><span class="dot dot-read"></span>read · left face</button>
      <button class="legend-chip" data-status="reading"><span class="dot dot-reading"></span>reading now · front face</button>
      <button class="legend-chip" data-status="toread"><span class="dot dot-toread"></span>to read · right face</button>
    </div>
  </div>
  <script type="application/json" id="library-data" set:html={JSON.stringify(books)} />

<style is:global>
/* Library scene. Global on purpose: most nodes are created by the script below,
   which Astro's scoped styles cannot reach. Everything is namespaced under .scene-wrap. */
.scene-wrap { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; position: relative; margin: 1.6rem 0 0.6rem; user-select: none; }
.scene-hint { position: absolute; top: 0.7rem; left: 50%; transform: translateX(-50%); font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--muted); background: color-mix(in srgb, var(--bg) 82%, transparent); border: 1px solid var(--border); border-radius: 99px; padding: 0.15rem 0.8rem; pointer-events: none; z-index: 30; white-space: nowrap; }
.scene-viewport { height: clamp(430px, 68vh, 620px); overflow: hidden; position: relative;
  background: linear-gradient(180deg, var(--bg-raised), var(--bg) 75%); }
.scene-wrap .layer { position: absolute; inset: 0; pointer-events: none; }

/* clean backdrop: warm glow, soft ground, nothing else */
.scene-wrap .glow { position: absolute; left: 50%; top: 46%; width: 780px; height: 580px; transform: translate(-50%, -50%);
  background: radial-gradient(ellipse, rgba(255,178,88,0.30), rgba(255,178,88,0.10) 45%, transparent 68%); filter: blur(8px); }
.scene-wrap .ground { position: absolute; left: 0; right: 0; top: 79%; bottom: 0;
  background: linear-gradient(180deg, color-mix(in srgb, var(--fg) 7%, transparent), transparent 75%); }
.scene-wrap .ground::before { content: ""; position: absolute; left: 6%; right: 6%; top: 0; height: 1px; background: color-mix(in srgb, var(--fg) 14%, transparent); }
.scene-wrap .tower-shadow { position: absolute; left: 50%; top: 76%; width: 560px; height: 70px; margin-left: -280px; background: radial-gradient(ellipse, rgba(60,35,15,0.4), transparent 70%); filter: blur(6px); }

/* the tower */
.scene-wrap .atrium { position: absolute; inset: 0; perspective: 1500px; perspective-origin: 50% 42%; z-index: 5; }
.scene-wrap .tower { position: absolute; left: 50%; bottom: 112px; width: 330px; height: 415px; margin-left: -165px; transform-style: preserve-3d; transform-origin: 50% 68%; will-change: transform; }
.scene-wrap .tower.zooming-out { transition: transform 0.6s cubic-bezier(0.3,0.7,0.3,1); }
.scene-viewport { cursor: pointer; }
.scene-viewport.interactive { cursor: grab; }
.scene-hint.on { border-color: var(--accent); color: var(--accent); }
.scene-viewport.dragging { cursor: grabbing; }
.scene-wrap .face { position: absolute; top: 0; height: 100%; overflow: hidden; cursor: pointer; background: linear-gradient(180deg, #b07a42, #9a662f 30%, #8a5826 70%, #7a4c20); }
.scene-wrap .face svg { display: block; width: 100%; height: 100%; }
.scene-wrap .face::after { content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 90% 60% at 50% 42%, rgba(255,190,100,0.28), transparent 75%),
    linear-gradient(90deg, rgba(40,20,5,0.5), transparent 12%, transparent 88%, rgba(40,20,5,0.5)),
    linear-gradient(180deg, rgba(40,20,5,0.3), transparent 15%, transparent 82%, rgba(40,20,5,0.45));
  pointer-events: none; }
.scene-wrap .face:hover::after, .scene-wrap .face:focus-visible::after { background:
    radial-gradient(ellipse 90% 60% at 50% 42%, rgba(255,205,120,0.45), transparent 78%),
    linear-gradient(90deg, rgba(40,20,5,0.4), transparent 12%, transparent 88%, rgba(40,20,5,0.4)),
    linear-gradient(180deg, rgba(40,20,5,0.25), transparent 15%, transparent 82%, rgba(40,20,5,0.4)); }
.scene-wrap .face-front { left: 0; width: 100%; border-radius: 34px 34px 4px 4px / 20px 20px 4px 4px; transform: translateZ(58px); }
.scene-wrap .face-left  { left: -118px; width: 118px; transform-origin: 100% 50%; transform: translateZ(58px) rotateY(-64deg); border-radius: 26px 0 0 4px / 16px 0 0 4px; }
.scene-wrap .face-right { right: -118px; width: 118px; transform-origin: 0% 50%; transform: translateZ(58px) rotateY(64deg); border-radius: 0 26px 4px 0 / 0 16px 4px 0; }
.scene-wrap .face-label { position: absolute; left: 50%; transform: translateX(-50%); top: 40%; z-index: 3; pointer-events: none; text-align: center; }
.scene-wrap .face-label .w { font-family: var(--display); font-weight: 900; font-size: 15px; letter-spacing: 0.28em; text-indent: 0.28em; color: #ffe9c4; text-shadow: 0 0 12px rgba(255,180,80,0.95), 0 0 26px rgba(255,150,50,0.6); white-space: nowrap; }
.scene-wrap .face-label .c { display: block; font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.1em; color: #ffdba8; opacity: 0.85; text-shadow: 0 0 8px rgba(255,170,70,0.8); margin-top: 1px; }
.scene-wrap .embedded-book { position: absolute; width: 30px; height: 44px; border: none; padding: 0; border-radius: 2px; overflow: hidden; cursor: pointer; z-index: 2; background: #3a2c1c; box-shadow: 0 3px 8px rgba(0,0,0,0.5); transition: transform 0.2s ease; }
.scene-wrap .embedded-book img { width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; border: none; padding: 0; }
.scene-wrap .embedded-book .gen { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 2px; font-family: var(--display); font-weight: 800; font-size: 5.5px; line-height: 1.1; color: #fff; text-align: left; }
.scene-wrap .embedded-book:hover, .scene-wrap .embedded-book:focus-visible { transform: scale(1.7); z-index: 3; }
.scene-wrap .embedded-book.reading { animation: lib-embglow 2.4s ease-in-out infinite; }
@keyframes lib-embglow { 0%,100% { box-shadow: 0 0 10px 3px rgba(255,140,50,0.7); } 50% { box-shadow: 0 0 22px 8px rgba(255,150,60,0.95); } }
.scene-wrap .tower-sign { position: absolute; top: 26px; left: 0; right: 0; text-align: center; z-index: 4; pointer-events: none; }
.scene-wrap .tower-sign .kr { font-family: var(--display); font-weight: 800; font-size: 21px; letter-spacing: 0.12em; color: #ffe9c4; text-shadow: 0 0 14px rgba(255,190,90,1), 0 0 34px rgba(255,150,50,0.75); }
.scene-wrap .tower-sign .en { display: block; font-family: var(--mono); font-size: 9px; letter-spacing: 0.42em; text-indent: 0.42em; color: #ffdba8; opacity: 0.9; text-shadow: 0 0 8px rgba(255,170,70,0.9); margin-top: 2px; }
.scene-wrap .tower.zoomed { transition: transform 0.6s cubic-bezier(0.3,0.7,0.3,1); transform: scale(2.35) translateY(9%); }
.scene-viewport.dimmed .layer { filter: brightness(0.55) saturate(0.8); transition: filter 0.5s ease; }

/* close-up shelf: face-out books, covers forward */
.scene-wrap .closeup { position: absolute; inset: 0; z-index: 20; display: none; align-items: center; justify-content: center; background: rgba(20,12,5,0.55); backdrop-filter: blur(4px); }
.scene-wrap .closeup.open { display: flex; }
.scene-wrap .closeup-panel { width: min(90%, 740px); background: linear-gradient(180deg, #8a5826, #6e4319); border-radius: 14px; border: 1px solid rgba(255,200,120,0.25); box-shadow: 0 30px 80px rgba(0,0,0,0.5), inset 0 0 60px rgba(255,170,80,0.12); padding: 1.6rem 2rem 2rem; animation: lib-stepin 0.45s cubic-bezier(0.2,0.8,0.25,1); }
@keyframes lib-stepin { from { transform: scale(0.55); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.scene-wrap .closeup-panel .cw { font-family: var(--display); font-weight: 900; font-size: 26px; letter-spacing: 0.3em; text-indent: 0.3em; color: #ffe9c4; text-shadow: 0 0 16px rgba(255,180,80,0.95); text-align: center; margin-bottom: 1.2rem; }
.scene-wrap .closeup-shelf { position: relative; min-height: 190px; border-bottom: 12px solid #4a3018; background: linear-gradient(180deg, rgba(0,0,0,0.35), rgba(0,0,0,0.1)); border-radius: 4px 4px 0 0; display: flex; align-items: flex-end; justify-content: center; gap: 18px; padding: 16px 18px 0; flex-wrap: wrap; }
.scene-wrap .closeup-shelf .empty-hint { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 13px; font-style: italic; letter-spacing: 0.05em; color: #ffdba8; opacity: 0.6; }
.scene-wrap .bookcard { position: relative; display: flex; flex-direction: column; align-items: center; gap: 7px; width: 96px; border: none; background: none; padding: 0 0 10px; cursor: pointer; transition: transform 0.22s ease; }
.scene-wrap .bookcard:hover, .scene-wrap .bookcard:focus-visible { transform: translateY(-12px); }
.scene-wrap .bookcard .cover { position: relative; width: 96px; height: 138px; border-radius: 4px; overflow: hidden; background: #3a2c1c; box-shadow: 0 12px 26px rgba(0,0,0,0.5), inset -5px 0 10px rgba(0,0,0,0.25); }
.scene-wrap .bookcard .cover img { width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; border: none; padding: 0; }
.scene-wrap .bookcard .cover .gen { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 0.45rem; font-family: var(--display); font-weight: 800; font-size: 0.72rem; line-height: 1.15; color: #fff; text-align: left; text-shadow: 0 1px 3px rgba(0,0,0,0.5); }
.scene-wrap .bookcard .cap { font-family: var(--mono); font-size: 10px; letter-spacing: 0.04em; color: #ffdba8; opacity: 0.9; max-width: 96px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scene-wrap .bookcard.reading .cover { animation: lib-glow 2.4s ease-in-out infinite; }
@keyframes lib-glow { 0%,100% { box-shadow: 0 0 20px 4px rgba(255,140,50,0.55); } 50% { box-shadow: 0 0 40px 12px rgba(255,150,60,0.8); } }
.scene-wrap .bookcard.toread .cover::after { content: "TO READ"; position: absolute; top: 13px; right: -28px; transform: rotate(45deg); background: #a3781f; color: #fff; font-family: var(--mono); font-size: 8px; letter-spacing: 0.08em; padding: 2px 30px; box-shadow: 0 1px 4px rgba(0,0,0,0.4); }
.scene-wrap .closeup-back { position: absolute; top: 0.9rem; right: 1rem; font-family: var(--mono); font-size: 0.78rem; background: rgba(250,245,235,0.92); color: #5a4a35; border: none; border-radius: 6px; padding: 0.3rem 0.8rem; cursor: pointer; z-index: 22; }
.scene-wrap .closeup-back:hover { background: #fff; }

/* detail card */
.scene-wrap .detail-overlay { position: absolute; inset: 0; z-index: 25; display: none; align-items: center; justify-content: center; background: color-mix(in srgb, var(--navy) 30%, transparent); backdrop-filter: blur(3px); }
.scene-wrap .detail-overlay.open { display: flex; }
.scene-wrap .detail-card { position: relative; display: flex; gap: 1.4rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 12px; padding: 1.4rem 1.6rem; max-width: min(88%, 34rem); box-shadow: 0 24px 60px rgba(0,0,0,0.35); animation: lib-bookfly 0.45s cubic-bezier(0.2, 0.8, 0.25, 1); }
@keyframes lib-bookfly { from { transform: scale(0.12) rotate(-84deg); opacity: 0; } 60% { opacity: 1; } to { transform: scale(1) rotate(0); opacity: 1; } }
.scene-wrap .detail-cover { flex: 0 0 108px; height: 160px; border-radius: 4px; overflow: hidden; display: flex; align-items: flex-end; padding: 0; font-family: var(--display); font-weight: 800; font-size: 0.8rem; line-height: 1.15; color: #fff; box-shadow: inset -6px 0 12px rgba(0,0,0,0.25), 0 6px 16px rgba(0,0,0,0.25); }
.scene-wrap .detail-cover img { width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; border: none; padding: 0; }
.scene-wrap .detail-info h3 { font-family: var(--display); font-size: 1.25rem; margin: 0 0 0.1rem; }
.scene-wrap .detail-info .author { color: var(--muted); font-size: 0.92rem; margin: 0 0 0.6rem; }
.scene-wrap .detail-status { display: inline-block; font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; border-radius: 4px; padding: 0.12rem 0.55rem; margin-bottom: 0.4rem; }
.scene-wrap .detail-status.s-reading { background: var(--accent-soft); color: var(--accent); }
.scene-wrap .detail-status.s-read { background: color-mix(in srgb, var(--status) 18%, transparent); color: var(--status); }
.scene-wrap .detail-status.s-toread { background: var(--tag-3-bg); color: var(--tag-3); }
.scene-wrap .detail-info .dates { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin: 0 0 0.5rem; }
.scene-wrap .detail-info .blurb { font-size: 0.88rem; margin: 0; }
.scene-wrap .detail-close { position: absolute; top: -2.4rem; right: 0; font-family: var(--mono); font-size: 0.78rem; background: var(--bg-raised); color: var(--muted); border: 1px solid var(--border); border-radius: 6px; padding: 0.25rem 0.7rem; cursor: pointer; }

.scene-legend { display: flex; gap: 0.6rem; flex-wrap: wrap; padding: 0.8rem 1rem; border-top: 1px solid var(--border); background: var(--bg-raised); }
.legend-chip { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.04em; border: 1px solid var(--border); border-radius: 99px; padding: 0.18rem 0.85rem; background: var(--bg); color: var(--muted); cursor: pointer; display: inline-flex; align-items: center; gap: 0.45em; }
.legend-chip .dot { width: 0.6em; height: 0.6em; border-radius: 50%; display: inline-block; }
.legend-chip .dot-read { background: var(--status); }
.legend-chip .dot-reading { background: var(--accent); }
.legend-chip .dot-toread { background: var(--tag-3); }
.legend-chip:hover { border-color: var(--accent); color: var(--fg); }

@media (max-width: 720px) {
  .scene-wrap .tower { transform: scale(0.82); transform-origin: 50% 100%; }
}
</style>

<script is:inline>
(function () {
  var BOOKS = JSON.parse(document.getElementById('library-data').textContent);

  function pr(i, s) { var x = Math.sin(i * 127.1 + s * 311.7) * 43758.5453; return x - Math.floor(x); }
  var palette = ['#c0392b', '#d35400', '#e67e22', '#b5651d', '#8e5a2a', '#a04000', '#7d3c98', '#1f618d', '#117a65', '#935116', '#cd6155', '#d4ac0d', '#6e2c00', '#283747', '#7b7d7d'];
  var spineColor = function (title) {
    var h = 0;
    for (var i = 0; i < title.length; i++) h = (h * 31 + title.charCodeAt(i)) >>> 0;
    return palette[h % 7]; // warm-leaning slice for real books
  };
  function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }

  // Shelf rows of face-out book fronts (covers with a title band), with
  // occasional spine clusters and gaps for a real-bookshop texture.
  // Shelf rows sized to one book: row height matches the embedded real-book
  // covers (30x44), so filler and real books share the same scale.
  var seed = 0;
  function fillFace(face, W, res) {
    var H = 415, rowH = 50, parts = [];
    for (var y = rowH; y < H - 8; y += rowH) {
      var rowReserved = res && y > res.yTop && (y - rowH) < res.yBot;
      parts.push('<rect x="0" y="' + y.toFixed(1) + '" width="' + W + '" height="4" fill="#5a3a18"/>');
      parts.push('<rect x="0" y="' + (y + 4).toFixed(1) + '" width="' + W + '" height="2" fill="#2e1c0a" opacity="0.6"/>');
      var x = 4 + pr(++seed, 1) * 6;
      while (x < W - 14) {
        if (rowReserved && x > res.x1 - 6 && x < res.x2) { x = res.x2 + 3; continue; }
        seed++;
        var r = pr(seed, 6);
        if (r < 0.7) {
          // face-out cover at real-book scale, with title band and footer
          var bw = 25 + pr(seed, 2) * 7, bh = 38 + pr(seed, 3) * 6;
          var col = palette[Math.floor(pr(seed, 5) * palette.length)];
          parts.push('<rect x="' + x.toFixed(1) + '" y="' + (y - bh).toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + bh.toFixed(1) + '" rx="1.5" fill="' + col + '"/>');
          parts.push('<rect x="' + (x + 3.5).toFixed(1) + '" y="' + (y - bh + 5).toFixed(1) + '" width="' + (bw - 7).toFixed(1) + '" height="4.5" fill="#ffffff" opacity="0.55"/>');
          parts.push('<rect x="' + (x + 3.5).toFixed(1) + '" y="' + (y - 9).toFixed(1) + '" width="' + (bw - 7).toFixed(1) + '" height="3" fill="#000000" opacity="0.25"/>');
          x += bw + 3.5;
        } else if (r < 0.93) {
          // spine cluster between the displays, same shelf height
          var n = 2 + Math.floor(pr(seed, 7) * 4);
          for (var k = 0; k < n && x < W - 10; k++) {
            seed++;
            var sw = 6 + pr(seed, 2) * 3.5, sh = 38 + pr(seed, 3) * 6;
            parts.push('<rect x="' + x.toFixed(1) + '" y="' + (y - sh).toFixed(1) + '" width="' + sw.toFixed(1) + '" height="' + sh.toFixed(1) + '" fill="' + palette[Math.floor(pr(seed, 5) * palette.length)] + '"/>');
            x += sw + 1.4;
          }
          x += 2.5;
        } else {
          x += 10 + pr(seed, 8) * 16;
        }
      }
    }
    face.insertAdjacentHTML('afterbegin', '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + W + ' 415" preserveAspectRatio="none">' + parts.join('') + '</svg>');
  }
  // Real books are embedded into the tower itself: reserve a slot on each
  // face's shelf band, then place the actual covers there (clickable).
  var faceEls = {
    reading: document.querySelector('.face-front'),
    read: document.querySelector('.face-left'),
    toread: document.querySelector('.face-right')
  };
  var faceW = { reading: 330, read: 118, toread: 118 };
  var EMB_W = 30, EMB_H = 44, EMB_BOTTOM = 300; // sits on the 6th shelf board (rows of 50)
  function reservedFor(status) {
    var n = BOOKS.filter(function (b) { return b.status === status; }).length;
    if (!n) return null;
    var W = faceW[status];
    var spacing = Math.min(38, (W - 24 - EMB_W) / Math.max(1, n - 1) || 38);
    var total = spacing * (n - 1) + EMB_W;
    return { x1: W / 2 - total / 2 - 4, x2: W / 2 + total / 2 + 4, yTop: EMB_BOTTOM - EMB_H - 2, yBot: EMB_BOTTOM, spacing: spacing };
  }
  var resFor = {};
  Object.keys(faceEls).forEach(function (status) {
    resFor[status] = reservedFor(status);
    fillFace(faceEls[status], faceW[status], resFor[status]);
  });
  Object.keys(faceEls).forEach(function (status) {
    var res = resFor[status];
    if (!res) return;
    BOOKS.filter(function (b) { return b.status === status; }).forEach(function (b, i) {
      var el = document.createElement('button');
      el.className = 'embedded-book ' + b.status;
      el.style.left = (res.x1 + 4 + i * res.spacing).toFixed(1) + 'px';
      el.style.top = (EMB_BOTTOM - EMB_H) + 'px';
      el.setAttribute('aria-label', b.title + ' by ' + b.author);
      if (b.cover) {
        el.innerHTML = '<img src="' + esc(b.cover) + '" alt="">';
      } else {
        var c = spineColor(b.title);
        el.innerHTML = '<span class="gen" style="background: linear-gradient(160deg, ' + c + ', color-mix(in srgb, ' + c + ' 60%, #000))">' + esc(b.title) + '</span>';
      }
      el.addEventListener('click', function (e) { e.stopPropagation(); if (dragDist < 8) openBook(b); });
      faceEls[status].appendChild(el);
    });
  });

  ['read', 'reading', 'toread'].forEach(function (st) {
    var n = BOOKS.filter(function (b) { return b.status === st; }).length;
    document.querySelector('[data-count="' + st + '"]').textContent = n ? n + (n === 1 ? ' BOOK' : ' BOOKS') : 'EMPTY';
  });

  // ---- camera: hover look, drag to rotate, wheel to zoom ----
  var viewport = document.getElementById('viewport');
  var tower = document.getElementById('tower');
  var layerBack = document.getElementById('layerBack');
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hoverRot = 0, dragRot = 0, targetZoom = 0.8;
  var curRot = 0, curZoom = 0.8, curPX = 0, zoomed = false;
  var active = false;
  var hintEl = viewport.parentElement.querySelector('.scene-hint');
  function setActive(on) {
    active = on;
    viewport.classList.toggle('interactive', on);
    if (hintEl) {
      hintEl.textContent = on ? 'scroll to zoom \u00b7 drag to rotate \u00b7 click a face to step closer \u00b7 click outside to release' : 'click the library to explore it';
      hintEl.classList.toggle('on', on);
    }
  }
  viewport.addEventListener('click', function () { if (!active) setActive(true); });
  document.addEventListener('click', function (e) { if (active && !viewport.contains(e.target) && !e.target.closest('.scene-legend')) setActive(false); });
  var dragging = false, dragDist = 0, lastX = 0;

  viewport.addEventListener('mousemove', function (e) {
    if (zoomed || dragging) return;
    var r = viewport.getBoundingClientRect();
    hoverRot = ((e.clientX - r.left) / r.width - 0.5) * 16;
  });
  function dragStart(x) { dragging = true; dragDist = 0; lastX = x; viewport.classList.add('dragging'); }
  function dragMove(x) {
    if (!dragging) return;
    var dx = x - lastX; lastX = x; dragDist += Math.abs(dx);
    dragRot = Math.max(-58, Math.min(58, dragRot + dx * 0.35));
  }
  function dragEnd() { dragging = false; viewport.classList.remove('dragging'); }
  viewport.addEventListener('mousedown', function (e) { if (!zoomed && active) dragStart(e.clientX); });
  window.addEventListener('mousemove', function (e) { dragMove(e.clientX); });
  window.addEventListener('mouseup', dragEnd);
  viewport.addEventListener('touchstart', function (e) { if (!zoomed && active) dragStart(e.touches[0].clientX); }, { passive: true });
  viewport.addEventListener('touchmove', function (e) { dragMove(e.touches[0].clientX); }, { passive: true });
  viewport.addEventListener('touchend', dragEnd);
  viewport.addEventListener('wheel', function (e) {
    if (zoomed || !active) return;
    e.preventDefault();
    targetZoom = Math.max(0.7, Math.min(2.6, targetZoom - e.deltaY * 0.0016));
  }, { passive: false });

  (function tick() {
    var k = reduced ? 1 : 0.09;
    var targetRot = dragRot + hoverRot * 0.4;
    curRot += (targetRot - curRot) * k;
    curZoom += (targetZoom - curZoom) * k;
    curPX += (-targetRot * 1.2 - curPX) * k;
    if (!zoomed) tower.style.transform = 'scale(' + curZoom.toFixed(3) + ') rotateY(' + curRot.toFixed(2) + 'deg)';
    layerBack.style.transform = 'translateX(' + (curPX * 0.5).toFixed(1) + 'px)';
    requestAnimationFrame(tick);
  })();

  // ---- step-closer view: face-out covers ----
  var closeup = document.getElementById('closeup');
  var closeupWord = document.getElementById('closeupWord');
  var closeupShelf = document.getElementById('closeupShelf');
  var words = { read: 'READ', reading: 'READING NOW', toread: 'TO READ' };
  function openCloseup(status) {
    zoomed = true;
    tower.style.transform = ''; // let the .zoomed class transition take over
    tower.classList.add('zoomed');
    viewport.classList.add('dimmed');
    closeupWord.textContent = words[status];
    closeupShelf.innerHTML = '';
    var books = BOOKS.filter(function (b) { return b.status === status; });
    if (!books.length) {
      closeupShelf.innerHTML = '<span class="empty-hint">nothing on this shelf yet</span>';
    }
    books.forEach(function (b) {
      var bk = document.createElement('button');
      bk.className = 'bookcard ' + b.status;
      bk.setAttribute('aria-label', b.title + ' by ' + b.author);
      var coverInner;
      if (b.cover) {
        coverInner = '<img src="' + esc(b.cover) + '" alt="">';
      } else {
        var c = spineColor(b.title);
        coverInner = '<span class="gen" style="background: linear-gradient(160deg, ' + c + ', color-mix(in srgb, ' + c + ' 60%, #000))">' + esc(b.title) + '</span>';
      }
      bk.innerHTML = '<span class="cover">' + coverInner + '</span><span class="cap">' + esc(b.title) + '</span>';
      bk.addEventListener('click', function () { openBook(b); });
      closeupShelf.appendChild(bk);
    });
    setTimeout(function () { closeup.classList.add('open'); }, reduced ? 0 : 280);
  }
  function closeCloseup() {
    zoomed = false;
    closeup.classList.remove('open');
    tower.classList.remove('zoomed');
    viewport.classList.remove('dimmed');
    if (location.hash) history.replaceState(null, '', location.pathname);
  }
  document.querySelectorAll('.face').forEach(function (f) {
    f.addEventListener('click', function () { if (active && dragDist < 8) openCloseup(f.getAttribute('data-status')); });
    f.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openCloseup(f.getAttribute('data-status')); } });
  });
  document.getElementById('closeupBack').addEventListener('click', closeCloseup);
  document.getElementById('legend').addEventListener('click', function (e) {
    var chip = e.target.closest('.legend-chip');
    if (chip) openCloseup(chip.getAttribute('data-status'));
  });

  // ---- detail card ----
  var overlay = document.getElementById('overlay');
  var labels = { reading: 'Reading now', read: 'Read', toread: 'To read' };
  function openBook(b) {
    document.getElementById('dTitle').textContent = b.title;
    document.getElementById('dAuthor').textContent = b.author;
    document.getElementById('dBlurb').textContent = b.note;
    var st = document.getElementById('dStatus');
    st.textContent = labels[b.status];
    st.className = 'detail-status s-' + b.status;
    var dates = document.getElementById('dDates');
    dates.textContent = [b.started ? 'started ' + b.started : null, b.finished ? 'finished ' + b.finished : null].filter(Boolean).join(' · ');
    var cov = document.getElementById('dCover');
    if (b.cover) {
      cov.style.background = 'none';
      cov.innerHTML = '<img src="' + esc(b.cover) + '" alt="Cover of ' + esc(b.title) + '">';
    } else {
      var c = spineColor(b.title);
      cov.style.background = 'linear-gradient(160deg, ' + c + ', color-mix(in srgb, ' + c + ' 60%, #000))';
      cov.innerHTML = '<span style="padding:0.55rem; text-shadow:0 1px 3px rgba(0,0,0,0.4)">' + esc(b.title) + '</span>';
    }
    overlay.classList.add('open');
    history.replaceState(null, '', '#' + b.id);
  }
  document.getElementById('dClose').addEventListener('click', function () { overlay.classList.remove('open'); });
  overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.classList.remove('open'); });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (overlay.classList.contains('open')) overlay.classList.remove('open');
    else if (closeup.classList.contains('open')) closeCloseup();
    else if (active) setActive(false);
  });

  // ---- deep link: /library#slug opens that book's shelf and card ----
  var slug = location.hash.replace('#', '');
  if (slug) {
    var hit = BOOKS.find(function (b) { return b.id === slug; });
    if (hit) { openCloseup(hit.status); setTimeout(function () { openBook(hit); }, reduced ? 0 : 500); }
  }
})();
</script>
