---
import '../styles/global.css';
interface Props { title: string; description: string; accent?: 'notes'; wide?: boolean; image?: string }
const { title, description, accent, wide, image = '/images/og/og-home.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="JP Perez, notes" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body data-accent={accent}>
    <header class="site-header">
      <a class="brand" href="/">JP Perez</a>
      <nav>
        <a href="/builds">Builds</a>
        <a href="/notes">Notes</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main class:list={{ wide }}><slot /></main>
    <footer class="site-footer">
      <span>© 2026 Juan Pablo Perez</span>
      <a href="mailto:juanepa1pr@gmail.com">Email</a>
      <a href="https://www.linkedin.com/in/juanpapr">LinkedIn</a>
      <a href={`https://github.com/JP-PR-art`}>GitHub</a>
    </footer>
  </body>
</html>
