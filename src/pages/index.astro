---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const builds = (await getCollection('builds'))
  .filter((b) => b.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base title="JP Perez, technical-commercial hybrid" description="Account Executive and Product Owner who ships working AI systems. Solutions consulting, CPQ, agentic workflows.">
  <h1>I sell complex software, own its delivery, and build working AI systems.</h1>
  <p>
    I am an Account Executive and Product Owner at a CPQ and 3D-configurator software vendor in Antwerp.
    I run the full technical sales cycle, closed more than €600K, and turn signed contracts into shipped
    solutions. Along the way I started building the tools I wished existed: multi-agent pipelines,
    an AI-driven sales ops system, and a client delivery portal running in production.
  </p>
  <p class="meta">Spanish C2 · French C1 · English C1 · Dutch B2 · based in Antwerp, Belgium</p>

  <h2>Featured builds</h2>
  {builds.length === 0 && <p class="meta">Case studies landing shortly.</p>}
  {builds.map((b) => (
    <div class="card">
      <h3><a href={`/builds/${b.id}`}>{b.data.title}</a></h3>
      <p>{b.data.summary}</p>
      <p>{b.data.stack.map((s) => <span class="tag">{s}</span>)}</p>
    </div>
  ))}

  <h2>Recent notes</h2>
  {notes.length === 0 && <p class="meta">First notes coming soon.</p>}
  <ul>
    {notes.map((n) => (
      <li><a href={`/notes/${n.id}`}>{n.data.title}</a> <span class="meta">{n.data.date.toISOString().slice(0, 10)}</span></li>
    ))}
  </ul>

  <h2>Get in touch</h2>
  <p>
    <a href="mailto:juanepa1pr@gmail.com">Email me</a>, find me on
    <a href="https://www.linkedin.com/in/juanpapr"> LinkedIn</a>, or
    <a href="/cv/jp-perez-cv.pdf">download my CV</a>.
  </p>
</Base>
