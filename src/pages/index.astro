---
import Base from '../layouts/Base.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { getCollection } from 'astro:content';
const builds = (await getCollection('builds'))
  .filter((b) => b.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const vitals = [
  { label: 'Based', value: 'Antwerp, Belgium', sub: 'ES · FR · EN · NL' },
  { label: 'Closed', value: '€600K+' },
  { label: 'Status', value: 'Open to work', status: true },
];
---
<Base title="JP Perez, technical-commercial hybrid" description="Account Executive and Product Owner who ships working AI systems. Solutions consulting, CPQ, agentic workflows.">
  <div class="hero">
    <p class="eyebrow">Account Executive · Product Owner · AI builder</p>
    <h1>I sell complex software, own its delivery, and build working AI systems.</h1>
    <p class="lede">
      I am an Account Executive and Product Owner at a CPQ and 3D-configurator software vendor in Antwerp.
      I run the full technical sales cycle, closed more than €600K, and turn signed contracts into shipped
      solutions. Along the way I started building the tools I wished existed: multi-agent pipelines,
      an AI-driven sales ops system, and a client delivery portal running in production.
    </p>
    <TitleBlock fields={vitals} />
  </div>

  <h2>Featured builds</h2>
  {builds.length === 0 && <p class="meta">Case studies landing shortly.</p>}
  <div class="build-grid">
    {builds.map((b) => (
      <a class="build-tile" href={`/builds/${b.id}`}>
        {b.data.cover ? (
          <div class="build-tile__frame">
            <img src={b.data.cover} alt={`${b.data.title} workflow`} loading="lazy" />
          </div>
        ) : (
          <div class="build-tile__frame build-tile__frame--plate">
            <span>{b.data.stack.join(' + ')}</span>
          </div>
        )}
        <p class="build-tile__meta">{b.data.stack.slice(0, 3).join(' · ')}</p>
        <h3 class="build-tile__title">{b.data.title}</h3>
      </a>
    ))}
  </div>

  <h2>Recent notes</h2>
  {notes.length === 0 && <p class="meta">First notes coming soon.</p>}
  <ul class="note-index">
    {notes.map((n) => (
      <li>
        <div class="note-index-row">
          <a href={`/notes/${n.id}`}>{n.data.title}</a>
          <span class="spacer"></span>
          <span class="date">{n.data.date.toISOString().slice(0, 10)}</span>
        </div>
      </li>
    ))}
  </ul>

  <h2>Get in touch</h2>
  <p>
    <a href="mailto:juanepa1pr@gmail.com">Email me</a>, find me on
    <a href="https://www.linkedin.com/in/juanpapr"> LinkedIn</a>, or
    <a href="/cv/jp-perez-cv.pdf">download my CV</a>.
  </p>
</Base>
