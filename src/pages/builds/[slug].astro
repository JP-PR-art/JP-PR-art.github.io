---
import Base from '../../layouts/Base.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const builds = await getCollection('builds');
  return builds.map((b) => ({ params: { slug: b.id }, props: { build: b } }));
}
const { build } = Astro.props;
const { Content } = await render(build);
const fields = [
  { label: 'Published', value: build.data.date.toISOString().slice(0, 10) },
  { label: 'Stack', value: build.data.stack.join(' · ') },
  { label: 'Status', value: 'Shipped', status: true },
];
---
<Base title={`${build.data.title}, JP Perez`} description={build.data.summary}>
  <h1>{build.data.title}</h1>
  <TitleBlock fields={fields} />
  <div class="build-body">
    <Content />
  </div>
</Base>
